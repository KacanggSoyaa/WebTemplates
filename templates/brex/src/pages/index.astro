---
import Layout from "../layouts/Layout.astro";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import LogoBand from "../components/LogoBand.astro";
import StatsBand from "../components/StatsBand.astro";
import Features from "../components/Features.astro";
import Integrations from "../components/Integrations.astro";
import Testimonials from "../components/Testimonials.astro";
import Resources from "../components/Resources.astro";
import CtaBand from "../components/CtaBand.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <AnnouncementBar />
  <Nav />
  <main id="main">
    <Hero />
    <LogoBand />
    <StatsBand />
    <Features />
    <Integrations />
    <Testimonials />
    <Resources />
    <CtaBand />
  </main>
  <Footer />
</Layout>
