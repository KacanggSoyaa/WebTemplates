---
interface Props {
  name:
    | "arrow-right"
    | "arrow-up-right"
    | "chevron-down"
    | "check"
    | "play"
    | "mail"
    | "card"
    | "receipt"
    | "plane"
    | "bank"
    | "chart"
    | "layers";
  class?: string;
  size?: number;
  strokeWidth?: number;
}

const {
  name,
  class: className = "",
  size = 20,
  strokeWidth = 1.75,
} = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  {name === "arrow-right" && <path d="M4 12h15m0 0-6-6m6 6-6 6" />}
  {name === "arrow-up-right" && <path d="M7 17 17 7m0 0H8m9 0v9" />}
  {name === "chevron-down" && <path d="m6 9 6 6 6-6" />}
  {name === "check" && <path d="m4.5 12.5 5 5 10-11" />}
  {name === "play" && <path d="M8 6.5v11l9-5.5-9-5.5Z" fill="currentColor" stroke="none" />}
  {name === "mail" && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3.5 6 8.5 7 8.5-7" />
    </>
  )}
  {name === "card" && (
    <>
      <rect x="3" y="6" width="18" height="12" rx="2" />
      <path d="M3 10h18" />
      <path d="M7 14h4" />
    </>
  )}
  {name === "receipt" && (
    <>
      <path d="M6 3h12v18l-2-1.5-2 1.5-2-1.5-2 1.5-2-1.5-2 1.5V3Z" />
      <path d="M9 8h6M9 12h6M9 16h4" />
    </>
  )}
  {name === "plane" && <path d="M21 4 3 11l7 2.5L12.5 21 21 4Z" />}
  {name === "bank" && (
    <>
      <path d="M3 9 12 4l9 5" />
      <path d="M4 9v9M8 9v9M12 9v9M16 9v9M20 9v9M3 18h18" />
    </>
  )}
  {name === "chart" && (
    <>
      <path d="M4 20V4" />
      <path d="M4 20h16" />
      <path d="m7 15 4-4 3 2.5L20 7" />
    </>
  )}
  {name === "layers" && (
    <>
      <path d="M12 3.5 21 8.5 12 13.5 3 8.5l9-5Z" />
      <path d="m3 13 9 5 9-5" />
    </>
  )}
</svg>
