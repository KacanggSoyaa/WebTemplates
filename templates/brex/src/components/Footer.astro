---
const columns = [
  {
    title: "Products",
    links: ["Corporate cards", "Expense management", "Travel", "Bill pay", "Banking"],
  },
  {
    title: "Solutions",
    links: ["Startups", "Mid-market", "Enterprise", "Ecommerce", "Life sciences"],
  },
  {
    title: "Resources",
    links: ["Blog", "Guides", "Webinars", "Help center", "Status"],
  },
  {
    title: "Company",
    links: ["About", "Careers", "Press", "Partners", "Contact"],
  },
];

const year = new Date().getFullYear();
---

<footer class="bg-abyss text-paper">
  <div class="container-page py-16 md:py-20">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <a href="#main" class="text-heading-sm font-semibold tracking-tight" aria-label="Brex home">
          brex
        </a>
        <p class="mt-4 max-w-[34ch] text-body-sm text-mist">
          The financial stack for growing companies. Cards, expenses, travel,
          bill pay, and banking — in one platform.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 lg:col-span-8">
        {
          columns.map((column) => (
            <div>
              <h3 class="text-body-sm font-semibold text-paper">{column.title}</h3>
              <ul class="mt-4 space-y-2.5">
                {column.links.map((link) => (
                  <li>
                    <a
                      href="#contact"
                      class="text-body-sm text-mist transition-colors hover:text-paper"
                    >
                      {link}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-white/10 pt-8 text-caption text-mist sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} Brex Inc. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <a href="#contact" class="transition-colors hover:text-paper">Privacy</a>
        <a href="#contact" class="transition-colors hover:text-paper">Terms</a>
        <a href="#contact" class="transition-colors hover:text-paper">Security</a>
      </div>
    </div>
  </div>
</footer>
