---
import Icon from "./Icon.astro";
---

<section id="contact" class="bg-paper py-20 md:py-28">
  <div class="container-page">
    <div class="mx-auto max-w-[720px] text-center">
      <h2
        class="text-[clamp(36px,5.2vw,56px)] font-semibold leading-[1.1] tracking-[-0.03em] text-ink"
      >
        Get started with Brex today
      </h2>
      <p class="mt-5 text-subheading text-graphite">
        Join 35,000+ companies that run their finances on Brex. Free to start,
        no personal guarantee required.
      </p>

      <form
        class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-stretch sm:justify-center"
        onsubmit="event.preventDefault()"
      >
        <label class="sr-only" for="cta-email">Work email</label>
        <input
          id="cta-email"
          type="email"
          placeholder="name@company.com"
          class="h-12 w-full rounded-[12px] border border-mist bg-paper px-4 text-body text-ink placeholder:text-steel focus:border-ink focus:outline-none sm:max-w-[320px]"
        />
        <button type="submit" class="btn-ember h-12 whitespace-nowrap">
          Get started
        </button>
      </form>

      <a
        href="#contact"
        class="mt-5 inline-flex items-center gap-2 text-body-sm font-medium text-ink transition-colors hover:text-ember"
      >
        <Icon name="play" size={14} class="text-ember" />
        See a demo
      </a>
    </div>
  </div>
</section>
