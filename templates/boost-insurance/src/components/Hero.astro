---
import Icon from "./Icon.astro";

const tags = ["Cyber", "Pet", "Travel", "Warranty"];

const coverage = [
  "Breach response & forensics",
  "Ransomware & extortion",
  "Business interruption",
];
---

<section class="topo relative overflow-hidden pb-24 pt-16 md:pb-32 md:pt-24">
  <div
    class="pointer-events-none absolute -left-40 top-24 -z-10 h-[420px] w-[420px] rounded-full bg-cyan-pulse/10 blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <div class="container-page grid items-center gap-16 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7">
      <p class="eyebrow reveal-init">Insurance infrastructure</p>

      <h1
        class="reveal-init mt-6 max-w-[13ch] text-[clamp(44px,8.4vw,88px)] font-light leading-[0.98] tracking-[-0.04em] text-bone"
        style="--reveal-delay: 80ms"
      >
        Insurance infrastructure for the{" "}
        <span class="accent-underline">modern world</span>
      </h1>

      <p
        class="reveal-init mt-8 max-w-[46ch] text-subheading font-light text-sea-mist"
        style="--reveal-delay: 160ms"
      >
        Launch insurance products in weeks, not quarters. Boost gives platforms a
        single API, one contract, and a compliance layer — with carriers, capital,
        and licensing already in place.
      </p>

      <div
        class="reveal-init mt-10 flex flex-wrap items-center gap-x-8 gap-y-5"
        style="--reveal-delay: 240ms"
      >
        <a
          href="#contact"
          class="gradient-cta group inline-flex items-center gap-2.5 rounded-full px-7 py-4 text-body font-medium transition-transform duration-200 hover:-translate-y-0.5"
        >
          Start building
          <Icon
            name="arrow-right"
            size={18}
            class="transition-transform duration-200 group-hover:translate-x-1"
          />
        </a>
        <a
          href="#developers"
          class="group inline-flex items-center gap-2 text-body text-sea-mist underline decoration-pale-foam/30 decoration-1 underline-offset-[6px] transition-colors hover:text-bone hover:decoration-lime-voltage/70"
        >
          Talk to an expert
          <Icon
            name="arrow-up-right"
            size={16}
            class="transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
          />
        </a>
      </div>

      <dl
        class="reveal-init mt-14 flex flex-wrap gap-x-12 gap-y-6 border-t border-pale-foam/10 pt-8"
        style="--reveal-delay: 320ms"
      >
        <div>
          <dt class="text-caption uppercase tracking-[0.35px] text-storm-glass">
            Live programs
          </dt>
          <dd class="mt-1.5 text-heading font-light text-bone">240+</dd>
        </div>
        <div>
          <dt class="text-caption uppercase tracking-[0.35px] text-storm-glass">
            Time to launch
          </dt>
          <dd class="mt-1.5 text-heading font-light text-bone">6 weeks</dd>
        </div>
        <div>
          <dt class="text-caption uppercase tracking-[0.35px] text-storm-glass">
            States covered
          </dt>
          <dd class="mt-1.5 text-heading font-light text-bone">50</dd>
        </div>
      </dl>
    </div>

    <div class="relative lg:col-span-5">
      <div
        class="pointer-events-none absolute -right-10 -top-10 -z-10 h-64 w-64 rounded-full bg-lime-voltage/10 blur-[90px]"
        aria-hidden="true"
      >
      </div>

      <div
        class="glass reveal-init relative rounded-[30px] p-6 md:p-7"
        style="--reveal-delay: 200ms"
      >
        <div class="flex items-center justify-between">
          <p class="text-caption uppercase tracking-[0.35px] text-storm-glass">
            Product preview
          </p>
          <span
            class="inline-flex items-center gap-1.5 rounded-full border border-lime-voltage/30 bg-lime-voltage/10 px-2.5 py-1 text-caption text-lime-voltage"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-lime-voltage"></span>
            Live
          </span>
        </div>

        <div class="mt-5 flex flex-wrap gap-2">
          {
            tags.map((tag, index) => (
              <span
                class:list={[
                  "rounded-full border px-3 py-1.5 text-body-sm transition-colors",
                  index === 0
                    ? "border-lime-voltage/50 bg-lime-voltage/10 text-lime-voltage"
                    : "border-pale-foam/15 text-sea-mist",
                ]}
              >
                {tag}
              </span>
            ))
          }
        </div>

        <div
          class="mt-6 rounded-[22px] border border-pale-foam/12 bg-abyss-teal/60 p-5"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-caption uppercase tracking-[0.35px] text-storm-glass">
                Cyber liability
              </p>
              <p class="mt-1.5 text-heading-sm font-normal text-bone">
                Small business
              </p>
            </div>
            <div class="text-right">
              <p class="text-heading-sm font-light text-bone">$8</p>
              <p class="text-caption text-storm-glass">per month</p>
            </div>
          </div>

          <ul class="mt-5 space-y-2.5 border-t border-pale-foam/10 pt-4">
            {
              coverage.map((item) => (
                <li class="flex items-center gap-2.5 text-body-sm text-pale-foam">
                  <Icon name="check" size={14} class="shrink-0 text-lime-voltage" />
                  {item}
                </li>
              ))
            }
          </ul>

          <div class="mt-5 flex items-center justify-between gap-3">
            <p class="text-caption text-storm-glass">Bound in 42 seconds</p>
            <button
              type="button"
              class="gradient-solar group inline-flex items-center gap-2 rounded-full px-4 py-2.5 text-body-sm font-medium transition-transform duration-200 hover:-translate-y-0.5"
            >
              Get a quote
              <Icon
                name="arrow-right"
                size={15}
                class="transition-transform duration-200 group-hover:translate-x-0.5"
              />
            </button>
          </div>
        </div>

        <div class="mt-5 flex items-center justify-between text-caption text-storm-glass">
          <span class="inline-flex items-center gap-1.5">
            <Icon name="shield" size={13} class="text-sea-mist" />
            Carrier-backed
          </span>
          <span>API v2.4</span>
        </div>
      </div>
    </div>
  </div>
</section>
