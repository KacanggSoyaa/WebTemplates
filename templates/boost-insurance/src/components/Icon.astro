---
interface Props {
  name:
    | "arrow-right"
    | "arrow-up-right"
    | "chevron-down"
    | "check"
    | "layers"
    | "shield"
    | "bolt"
    | "code"
    | "book"
    | "message"
    | "plug"
    | "chart"
    | "users"
    | "lock"
    | "plus";
  class?: string;
  size?: number;
  strokeWidth?: number;
}

const {
  name,
  class: className = "",
  size = 20,
  strokeWidth = 1.5,
} = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  {name === "arrow-right" && <path d="M4 12h15m0 0-6-6m6 6-6 6" />}
  {name === "arrow-up-right" && <path d="M7 17 17 7m0 0H8m9 0v9" />}
  {name === "chevron-down" && <path d="m6 9 6 6 6-6" />}
  {name === "check" && <path d="m4.5 12.5 5 5 10-11" />}
  {name === "layers" && (
    <>
      <path d="M12 3.5 21 8.5 12 13.5 3 8.5l9-5Z" />
      <path d="m3 13 9 5 9-5" />
      <path d="m3 17.5 9 5 9-5" />
    </>
  )}
  {name === "shield" && (
    <>
      <path d="M12 3 5 6v6c0 4.2 3 7.6 7 9 4-1.4 7-4.8 7-9V6l-7-3Z" />
      <path d="m9 12 2 2 4-4.5" />
    </>
  )}
  {name === "bolt" && <path d="M13 3 5 13.5h5.5L11 21l8-10.5h-5.5L13 3Z" />}
  {name === "code" && (
    <>
      <path d="m8.5 8.5-4 3.5 4 3.5" />
      <path d="m15.5 8.5 4 3.5-4 3.5" />
      <path d="M13.5 5 10.5 19" />
    </>
  )}
  {name === "book" && (
    <>
      <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15.5H6.5A2.5 2.5 0 0 0 4 21V5.5Z" />
      <path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H20" />
    </>
  )}
  {name === "message" && (
    <path d="M20 12.5c0 3.9-3.6 7-8 7-1 0-2-.2-2.9-.5L4 21l1.4-3.6A6.6 6.6 0 0 1 4 12.5c0-3.9 3.6-7 8-7s8 3.1 8 7Z" />
  )}
  {name === "plug" && (
    <>
      <path d="M9 3v5M15 3v5" />
      <path d="M7 8h10v3a5 5 0 0 1-10 0V8Z" />
      <path d="M12 16v5" />
    </>
  )}
  {name === "chart" && (
    <>
      <path d="M4 20V4" />
      <path d="M4 20h16" />
      <path d="m7 15 4-4 3 2.5L20 7" />
    </>
  )}
  {name === "users" && (
    <>
      <circle cx="9.5" cy="8.5" r="3.5" />
      <path d="M3.5 20c.6-3.4 3.1-5.5 6-5.5s5.4 2.1 6 5.5" />
      <path d="M16.5 5.4a3.5 3.5 0 0 1 0 6.2M17.5 14.8c2 .7 3.4 2.5 3.8 5.2" />
    </>
  )}
  {name === "lock" && (
    <>
      <rect x="4.5" y="10.5" width="15" height="10" rx="2.5" />
      <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
    </>
  )}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
</svg>
