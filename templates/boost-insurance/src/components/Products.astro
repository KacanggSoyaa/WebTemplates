---
import Icon from "./Icon.astro";

const products = [
  {
    name: "Cyber liability",
    blurb:
      "Protection for breach response, ransomware, and business interruption — sold inside the tools small businesses already use.",
    metric: "$8/mo",
    metricLabel: "starting premium",
    icon: "lock",
    featured: true,
  },
  {
    name: "Pet health",
    blurb: "Vet-bill coverage embedded at checkout and onboarding.",
    metric: "34%",
    metricLabel: "attach rate",
    icon: "shield",
  },
  {
    name: "Travel",
    blurb: "Trip protection and cancel-for-any-reason at booking.",
    metric: "2 min",
    metricLabel: "to bind",
    icon: "bolt",
  },
  {
    name: "Warranty",
    blurb: "Device and appliance coverage for commerce platforms.",
    metric: "50",
    metricLabel: "states live",
    icon: "plug",
  },
] as const;
---

<section id="products" class="relative overflow-hidden py-24 md:py-32">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow reveal-init">Products</p>
        <h2
          class="reveal-init mt-5 max-w-[18ch] text-[clamp(34px,5.2vw,56px)] font-light leading-[1.02] tracking-[-0.035em]"
          style="--reveal-delay: 80ms"
        >
          Products built for the{" "}
          <span class="accent-underline">modern world.</span>
        </h2>
      </div>
      <p
        class="reveal-init max-w-[42ch] text-subheading font-light text-sea-mist lg:col-span-5 lg:justify-self-end"
        style="--reveal-delay: 160ms"
      >
        Pick a line of coverage, white-label it, and ship. Every product arrives
        with carrier paper, pricing, and claims ops attached.
      </p>
    </div>

    <div
      class="reveal-init mt-16 lg:-rotate-[2.5deg] lg:[perspective:1600px]"
      style="--reveal-delay: 200ms"
    >
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          products.map((product) => (
            <article
              class:list={[
                "card-frame group relative overflow-hidden p-7 transition-all duration-300 hover:-translate-y-1 hover:border-lime-voltage/30 hover:bg-slate-reef/50 lg:hover:rotate-[2.5deg]",
                product.featured && "sm:row-span-2 sm:flex sm:flex-col sm:justify-between",
              ]}
            >
              <div>
                <div class="flex items-center justify-between">
                  <span class="grid h-11 w-11 place-items-center rounded-[10px] border border-pale-foam/15 bg-abyss-teal/50 text-lime-voltage">
                    <Icon name={product.icon} size={19} />
                  </span>
                  {product.featured && (
                    <span class="rounded-full border border-pale-foam/15 px-2.5 py-1 text-caption uppercase tracking-[0.35px] text-storm-glass">
                      Most requested
                    </span>
                  )}
                </div>

                <h3 class="mt-8 text-heading font-normal tracking-[-0.02px] text-bone">
                  {product.name}
                </h3>
                <p class="mt-3 max-w-[34ch] text-body-sm leading-relaxed text-sea-mist">
                  {product.blurb}
                </p>
              </div>

              <div class="mt-8 flex items-end justify-between gap-4 border-t border-pale-foam/10 pt-5">
                <div>
                  <p class="text-heading-sm font-light text-bone">
                    {product.metric}
                  </p>
                  <p class="mt-0.5 text-caption uppercase tracking-[0.35px] text-storm-glass">
                    {product.metricLabel}
                  </p>
                </div>
                <Icon
                  name="arrow-up-right"
                  size={18}
                  class="text-storm-glass transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-lime-voltage"
                />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
