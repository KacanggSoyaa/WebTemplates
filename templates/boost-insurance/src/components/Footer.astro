---
import Icon from "./Icon.astro";

const columns = [
  {
    title: "Products",
    links: ["Cyber liability", "Pet health", "Travel", "Warranty", "Parametric"],
  },
  {
    title: "Platform",
    links: ["API reference", "Sandbox", "Status", "Changelog", "Security"],
  },
  {
    title: "Company",
    links: ["About", "Careers", "Customers", "Blog", "Contact"],
  },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-pale-foam/10 bg-abyss-teal">
  <div class="container-page py-16 md:py-20">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <a href="#main" class="flex items-center gap-2.5" aria-label="Boost home">
          <span
            class="grid h-9 w-9 place-items-center rounded-[10px] bg-deep-kelp text-lime-voltage ring-1 ring-pale-foam/15"
          >
            <Icon name="layers" size={20} />
          </span>
          <span class="text-heading-sm font-medium tracking-tight">boost</span>
        </a>
        <p class="mt-5 max-w-[32ch] text-body-sm leading-relaxed text-storm-glass">
          Insurance infrastructure for the modern world. Built for platforms,
          backed by carriers, loved by developers.
        </p>
        <p
          class="mt-6 inline-flex items-center gap-2 rounded-full border border-pale-foam/15 px-3 py-1.5 text-caption text-sea-mist"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-lime-voltage"></span>
          All systems operational
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-8">
        {
          columns.map((column) => (
            <div>
              <h3 class="text-caption uppercase tracking-[0.35px] text-storm-glass">
                {column.title}
              </h3>
              <ul class="mt-5 space-y-3">
                {column.links.map((link) => (
                  <li>
                    <a
                      href="#contact"
                      class="text-body-sm text-pale-foam transition-colors hover:text-lime-voltage"
                    >
                      {link}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-pale-foam/10 pt-8 text-caption text-storm-glass sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} Boost Insurance Agency, Inc. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <a href="#contact" class="transition-colors hover:text-pale-foam">
          Privacy
        </a>
        <a href="#contact" class="transition-colors hover:text-pale-foam">
          Terms
        </a>
        <a href="#contact" class="transition-colors hover:text-pale-foam">
          Licensing
        </a>
      </div>
    </div>
  </div>
</footer>
