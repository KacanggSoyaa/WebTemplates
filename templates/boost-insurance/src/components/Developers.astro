---
import Icon from "./Icon.astro";

const bullets = [
  "REST and webhooks, typed SDKs in six languages",
  "Sandbox with test carriers in one command",
  "Quotes, binds, endorsements, and claims in one schema",
];
---

<section id="developers" class="relative py-24 md:py-32">
  <div class="container-page grid items-center gap-14 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5">
      <p class="eyebrow reveal-init">Developers</p>
      <h2
        class="reveal-init mt-5 max-w-[16ch] text-[clamp(34px,5vw,54px)] font-light leading-[1.04] tracking-[-0.035em]"
        style="--reveal-delay: 80ms"
      >
        One API for every <span class="accent-underline">line of coverage.</span>
      </h2>
      <p
        class="reveal-init mt-6 max-w-[44ch] text-subheading font-light text-sea-mist"
        style="--reveal-delay: 140ms"
      >
        Skip the carrier integrations, PDFs, and reconciliation spreadsheets. One
        contract, one schema, one place to read the docs.
      </p>

      <ul class="reveal-init mt-8 space-y-3.5" style="--reveal-delay: 200ms">
        {
          bullets.map((bullet) => (
            <li class="flex items-start gap-3 text-body text-pale-foam">
              <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full border border-lime-voltage/40 text-lime-voltage">
                <Icon name="check" size={12} strokeWidth={2} />
              </span>
              {bullet}
            </li>
          ))
        }
      </ul>

      <a
        href="#resources"
        class="reveal-init group mt-9 inline-flex items-center gap-2 text-body font-medium text-bone"
        style="--reveal-delay: 260ms"
      >
        <span class="border-b border-lime-voltage/60 pb-0.5 transition-colors group-hover:border-lime-voltage">
          Read the API reference
        </span>
        <Icon
          name="arrow-right"
          size={17}
          class="text-lime-voltage transition-transform duration-200 group-hover:translate-x-1"
        />
      </a>
    </div>

    <div class="reveal-init lg:col-span-7" style="--reveal-delay: 160ms">
      <div class="glass overflow-hidden rounded-[26px]">
        <div
          class="flex items-center justify-between border-b border-pale-foam/10 px-5 py-3.5"
        >
          <div class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-pale-foam/20"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-pale-foam/20"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-lime-voltage/60"></span>
          </div>
          <span class="text-caption tracking-[0.08px] text-storm-glass">
            POST /v1/quotes
          </span>
          <span class="text-caption text-lime-voltage">200 OK</span>
        </div>

        <pre
          class="overflow-x-auto p-6 text-[12.5px] leading-[1.85] text-pale-foam md:p-7 md:text-body-sm"
        ><code><span class="text-storm-glass">import</span> Boost <span class="text-storm-glass">from</span> <span class="text-cyan-pulse">"@boost/api"</span>;

<span class="text-storm-glass">const</span> boost = <span class="text-storm-glass">new</span> <span class="text-lime-voltage">Boost</span>(process.env.BOOST_KEY);

<span class="text-storm-glass">const</span> quote = <span class="text-storm-glass">await</span> boost.quotes.<span class="text-lime-voltage">create</span>(&#123;
  product: <span class="text-cyan-pulse">"cyber_smb"</span>,
  applicant: &#123; state: <span class="text-cyan-pulse">"NY"</span>, revenue: <span class="text-solar-yellow">420000</span> &#125;,
  limits: &#123; aggregate: <span class="text-solar-yellow">1000000</span> &#125;,
&#125;);

<span class="text-storm-glass">const</span> policy = <span class="text-storm-glass">await</span> boost.policies.<span class="text-lime-voltage">bind</span>(quote.id);</code></pre>

        <div
          class="flex flex-wrap items-center justify-between gap-3 border-t border-pale-foam/10 px-6 py-4 text-caption text-storm-glass"
        >
          <span class="inline-flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-lime-voltage"></span>
            policy bound · 42s
          </span>
          <span>id: pol_9fK2xQ</span>
        </div>
      </div>
    </div>
  </div>
</section>
